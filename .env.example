PORT=3000
OPENLINE_SERVER_SECRET=generate-a-long-random-secret-at-least-32-chars
OPENLINE_MASTER_PASSWORD=change-this-before-deploy
# Or use a scrypt hash generated by the server tooling instead of plaintext:
# OPENLINE_MASTER_PASSWORD_HASH=salt:derived_hash
# Leave empty when the browser and API share the same origin.
CORS_ORIGIN=
OPENLINE_DATA_FILE=./data/openline.json
